@model Vereinsverwaltung.Models.Mitglieder

<h2>Spieler löschen</h2>
<h3 class="text-danger">Bist du sicher, dass du diesen Spieler unwiderruflich löschen willst?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Vorname</dt>
        <dd class="col-sm-10">@Model.Vorname</dd>

        <dt class="col-sm-2">Nachname</dt>
        <dd class="col-sm-10">@Model.Nachname</dd>

        <dt class="col-sm-2">Geburtsdatum</dt>
        <dd class="col-sm-10">@Model.Geburtsdatum?.ToString("dd.MM.yyyy")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Aktuelle Mannschaft</dt>
        <dd class="col-sm-10">
            @(Model.Mannschaft != null ? Model.Mannschaft.Name : "Keine Mannschaft / Passiv")
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Mitglieder_Id" />

        <button type="submit" class="btn btn-danger">Ja, endgültig löschen</button>
        <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
    </form>
</div>