@model IEnumerable<Vereinsverwaltung.Models.Mitglieder>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mitglieder-Dashboard</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-2"></i>Neuen Spieler hinzufügen
    </a>
</div>

<div class="card mb-4 p-3 bg-light">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">

        <div class="col-md-4">
            <label class="form-label fw-bold small">Name suchen</label>
            <input type="text" name="searchString" class="form-control" placeholder="Vor- oder Nachname..." value="@ViewBag.CurrentSearch" />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold small">Mannschaft</label>
            <select name="mannschaftId" class="form-control">
                <option value="">-- Alle Teams --</option>
                @if (ViewBag.Mannschaften != null)
                {
                    foreach (var team in ViewBag.Mannschaften)
                    {
                        if (team.MannschaftsId == ViewBag.CurrentMannschaft)
                        {
                            <option value="@team.MannschaftsId" selected>@team.Name</option>
                        }
                        else
                        {
                            <option value="@team.MannschaftsId">@team.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold small">Status</label>
            <select name="status" class="form-control">
                <option value="">-- Alle Status --</option>
                <!option value="Aktiv" @(ViewBag.CurrentStatus == "Aktiv" ? "selected" : "")>Aktiv</!option>
                <!option value="Passiv" @(ViewBag.CurrentStatus == "Passiv" ? "selected" : "")>Passiv</!option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-success w-100">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-secondary w-100" title="Filter zurücksetzen">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>

    </form>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Vorname</th>
                <th>Nachname</th>
                <th>Geburtsdatum</th>
                <th>Status</th>
                <th>Mannschaft</th>
                <th>Beitragsklasse</th>
                <th>Beitrag</th>
                <th class="text-end">Aktionen</th>
                <th>Beitrag</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-exclamation-circle me-2"></i>Keine Spieler mit diesen Filtereinstellungen gefunden.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Vorname</td>
                        <td>@item.Nachname</td>
                        <td>@item.Geburtsdatum?.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge @(item.Status == "Aktiv" ? "bg-success" : "bg-secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            @(item.Mannschaft != null ? item.Mannschaft.Name : "Keine Mannschaft / Passiv")
                        </td>

                        <td>
                            @(string.IsNullOrEmpty(item.Beitragsklasse) ? "-" : item.Beitragsklasse)
                        </td>

                        <td class="align-middle">
                            <form asp-action="ToggleBezahltStatus" asp-route-id="@item.Mitglieder_Id" method="post" style="margin: 0;">
                                @if (item.HatBezahlt)
                                {
                                    <button type="submit" class="btn btn-sm btn-success w-100" title="Auf 'Offen' setzen">
                                        <i class="bi bi-check-circle me-1"></i> Bezahlt
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Auf 'Bezahlt' setzen">
                                        <i class="bi bi-x-circle me-1"></i> Offen
                                    </button>
                                }
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Mitglieder_Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil-square"></i> Bearbeiten
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Mitglieder_Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Löschen
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>