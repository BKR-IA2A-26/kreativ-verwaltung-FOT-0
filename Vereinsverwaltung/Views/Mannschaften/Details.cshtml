@model Vereinsverwaltung.Models.Mannschaften

@{
    ViewData["Title"] = "Kaderplanung - " + Model.Name;
    var kader = ViewBag.Kader as List<Vereinsverwaltung.Models.Mitglieder>;
}

<div class="mb-4 mt-2 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="display-6 fw-bold text-dark">Mannschafts-Cockpit</h1>
        <p class="text-muted m-0">Kaderplanung und Details für: <strong>@Model.Name</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Zurück zur Übersicht
    </a>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0 bg-white mb-4">
            <div class="card-header bg-dark text-white fw-bold text-uppercase small py-3">
                <i class="bi bi-shield-shaded me-2"></i> Team-Stammdaten
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-bold d-block">Mannschaftsname</label>
                    <span class="fs-5 fw-bold text-dark">@Model.Name</span>
                </div>

                <hr class="opacity-10" />

                <div>
                    <label class="text-muted small text-uppercase fw-bold d-block mb-2">Zuständiger Trainer</label>
                    @if (Model.Trainers != null)
                    {
                        <div class="d-flex align-items-center bg-light p-3 rounded-3">
                            <div class="bg-germania-red text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-person-badge-fill fs-5"></i>
                            </div>
                            <div>
                                <strong class="text-dark d-block">@Model.Trainer.Vorname @Model.Trainer.Nachname</strong>
                                <span class="badge bg-dark btn-sm fs-8">@Model.Trainer.Lizenzstufe</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Trainer.Telefonnummer))
                        {
                            <div class="mt-2 small text-muted">
                                <i class="bi bi-telephone me-1"></i> @Model.Trainer.Telefonnummer
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning m-0 small py-2">
                            <i class="bi bi-exclamation-triangle me-2"></i> Aktuell kein Trainer zugewiesen!
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-success text-white fw-bold text-uppercase small py-3">
                <i class="bi bi-person-plus-fill me-2"></i> Spieler transferieren
            </div>
            <div class="card-body p-4">
                <p class="small text-muted mb-3">Wähle ein Vereinsmitglied aus, um es fest in den Kader dieser Mannschaft aufzunehmen.</p>

                <form asp-action="SpielerHinzufuegen" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mannschaftId" value="@Model.MannschaftsId" />

                    <div class="mb-3">
                        <select name="mitgliedId" class="form-select" asp-items="ViewBag.VerfuegbareMitglieder" required>
                            <option value="">-- Spieler auswählen --</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-plus-circle me-1"></i> Dem Kader hinzufügen
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border-0 bg-white h-100">
            <div class="card-header bg-white border-0 fw-bold text-uppercase small text-muted pt-3 pb-0 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people-fill text-germania-red me-2"></i>Aktueller Kader (@(kader?.Count ?? 0) Spieler)</span>
            </div>
            <div class="card-body p-0 pt-2">
                <div class="table-responsive">
                    <table class="table align-middle m-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Status</th>
                                <th>Geburtsdatum</th>
                                <th class="text-end pe-4">Aktion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (kader == null || !kader.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="bi bi-emoji-frown display-6 d-block mb-2 opacity-50"></i>
                                        Der Kader ist aktuell noch leer. Benutze das linke Formular, um Spieler hinzuzufügen!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var spieler in kader)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">
                                            @spieler.Vorname @spieler.Nachname
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@spieler.Status</span>
                                        </td>
                                        <td class="text-muted small">
                                            @(spieler.Geburtsdatum.HasValue? spieler.Geburtsdatum.Value.ToString("dd.MM.yyyy") : "-")
                                        </td>
                                        <td class="text-end pe-4">
                                            <form asp-action="SpielerEntfernen" method="post" class="d-inline" onsubmit="return confirm('Möchtest du @spieler.Vorname wirklich aus dem Kader entfernen?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="mannschaftId" value="@Model.MannschaftsId" />
                                                <input type="hidden" name="mitgliedId" value="@spieler.Mitglieder_Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2 small">
                                                    <i class="bi bi-person-dash"></i> Rauswerfen
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>