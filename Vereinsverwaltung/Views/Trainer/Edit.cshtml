@model Vereinsverwaltung.Models.Trainer

<div class="container max-width-600 custom-form-container mt-4">
    <h2 class="mb-4">Trainer bearbeiten</h2>

    <div class="card shadow-sm border-0 p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="TrainerId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Vorname" class="form-label fw-semibold small">Vorname</label>
                    <input asp-for="Vorname" class="form-control" />
                    <span asp-validation-for="Vorname" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nachname" class="form-label fw-semibold small">Nachname</label>
                    <input asp-for="Nachname" class="form-control" />
                    <span asp-validation-for="Nachname" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Telefonnummer" class="form-label fw-semibold small">Telefonnummer</label>
                <input asp-for="Telefonnummer" class="form-control" />
                <span asp-validation-for="Telefonnummer" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Lizenzstufe" class="form-label fw-semibold small">Lizenzstufe</label>
                <select asp-for="Lizenzstufe" class="form-select">
                    <option value="">-- Keine Lizenz --</option>
                    <option value="C-Lizenz">C-Lizenz (Breitenfußball)</option>
                    <option value="B-Lizenz">B-Lizenz</option>
                    <option value="A-Lizenz">A-Lizenz</option>
                    <option value="Pro Lizenz">UEFA Pro Lizenz</option>
                </select>
                <span asp-validation-for="Lizenzstufe" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Änderungen speichern
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}