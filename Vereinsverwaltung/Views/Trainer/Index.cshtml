@model IEnumerable<Vereinsverwaltung.Models.Trainer>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Trainer-Übersicht</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-badge-fill me-2"></i>Neuen Trainer anlegen
    </a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Vorname</th>
                <th>Nachname</th>
                <th>Telefonnummer</th>
                <th>Lizenzstufe</th>
                <th class="text-end">Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        <i class="bi bi-exclamation-circle me-2"></i>Keine Trainer in der Datenbank gefunden.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Vorname</td>
                        <td>@item.Nachname</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Telefonnummer))
                            {
                                <span><i class="bi bi-telephone me-2 opacity-75"></i>@item.Telefonnummer</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-dark">
                                @(string.IsNullOrEmpty(item.Lizenzstufe) ? "Keine Lizenz" : item.Lizenzstufe)
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.TrainerId" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil-square"></i> Bearbeiten
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.TrainerId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Löschen
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>